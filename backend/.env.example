# CareerVerse AI backend configuration
# Copy to .env for local development and replace placeholders.

DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/careerverse_db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MAX_COMPLETION_TOKENS=800
OLLAMA_TIMEOUT=180

# Optional hosted provider fallback
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=800

CHROMADB_DIR=./chroma_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
SUPPORTED_LANGUAGES=en,ta,hi
DEFAULT_LANGUAGE=en
LANGUAGE_DETECTION_ENABLED=true

GITHUB_TOKEN=replace-with-github-token
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
